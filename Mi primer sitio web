<script>

function corregirQuiz() {

let puntaje = 0;

let respondidas = 0;

const respuestas = document.querySelectorAll(
'input[type="radio"]:checked'
);


respuestas.forEach(function(respuesta) {

respondidas++;

if (respuesta.value === "correct") {

puntaje++;

}

});


const resultado =
document.getElementById("resultado");


if (respondidas < 3) {

resultado.textContent =
"🌸 Respondé todas las preguntas primero.";

} else if (puntaje === 3) {

resultado.textContent =
"🎀 ¡Perfecto! 3/3 respuestas correctas.";

} else if (puntaje === 2) {

resultado.textContent =
"💗 ¡Muy bien! 2/3 respuestas correctas.";

} else if (puntaje === 1) {

resultado.textContent =
"🌷 1/3. ¡Podés volver a mirar el contenido!";

} else {

resultado.textContent =
"🌸 0/3. ¡No pasa nada! Intentá nuevamente.";

}

}

</script>

